{
  "name": "reellink",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:local": "bun --watch src/server.ts",
    "dev:detached": "docker compose -f docker-compose.dev.yml up --build -d",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f api",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:fresh": "docker compose -f docker-compose.dev.yml down -v",
    "deploy:server": "./scripts/deploy-server.sh",
    "start": "bun src/server.ts",
    "db:create": "bun src/db/create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:docker": "docker compose -f docker-compose.dev.yml exec api bun run db:seed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.8.0",
    "@scalar/hono-api-reference": "^0.10.20",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "nanoid": "^5.1.11",
    "postgres": "^3.4.9",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  }
}
